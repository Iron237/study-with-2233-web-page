  "groups": {
    "restScene.rest.generic": [
      {
        "id": "basic-1",
        "lines": [
          {
            "22": "今天的目标是什么？",
            "33": "keep on keeping on."
          }
        ]
      },
      {
        "id": "basic-2",
        "lines": [
          {
            "22": "这首歌适合单曲循环！",
            "33": "也适合安静地听完。"
          }
        ]
      },
      {
        "id": "basic-3",
        "lines": [
          {
            "22": "要不要喝一口水？",
            "33": "水杯就在手边的话，现在吧。"
          }
        ]
      },
      {
        "id": "basic-4",
        "lines": [
          {
            "22": "窗外的雨好像慢下来了。",
            "33": "下雨的声音很。"
          }
        ]
      },
      {
        "id": "basic-5",
        "lines": [
          {
            "22": "眼睛累了吗？",
            "33": "看一会儿远处吧。"
          }
        ]
      },
      {
        "id": "basic-6",
        "lines": [
          {
            "22": "我负责热闹一点。",
            "33": "我负责陪你安静一点。"
          }
        ]
      },
      {
        "id": "basic-7",
        "lines": [
          {
            "22": "刚刚是不是又走神啦？",
            "33": "发呆也可以是休息。"
          }
        ]
      },
      {
        "id": "basic-8",
        "lines": [
          {
            "22": "今天已经做了不少事呢。",
            "33": "剩下的，一件件来。"
          }
        ]
      },
      {
        "id": "basic-9",
        "lines": [
          {
            "22": "如果旋律也有颜色……",
            "33": "现在应该是暖黄色。"
          }
        ]
      },
      {
        "id": "basic-10",
        "lines": [
          {
            "22": "22:33 是我们的时间！",
            "33": "你已经找到入口了。"
          }
        ]
      },
      {
        "id": "basic-11",
        "lines": [
          {
            "22": "要不要换个舒服的坐姿？",
            "33": "肩膀放下来，慢慢呼吸。"
          }
        ]
      },
      {
        "id": "basic-12",
        "lines": [
          {
            "22": "听完这首再说？",
            "33": "嗯，听完这首。"
          }
        ]
      }
    ]
  }
